{
  "name": "@skywalking-horizon-ui/ui",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run --environment jsdom --root src/ --pool=threads",
    "test:unit:watch": "vitest --environment jsdom --root src/ --pool=threads",
    "build:mcp-app": "vite build --config vite.mcp-app.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@skywalking-horizon-ui/api-client": "workspace:*",
    "@skywalking-horizon-ui/design-tokens": "workspace:*",
    "@tanstack/vue-query": "^5.101.4",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "d3": "^7.9.0",
    "d3-flame-graph": "^4.1.3",
    "echarts": "^6.1.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^2.3.1",
    "three": "^0.184.0",
    "vue": "^3.5.40",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
