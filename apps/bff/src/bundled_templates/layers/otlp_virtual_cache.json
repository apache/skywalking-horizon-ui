{
  "key": "OTLP_VIRTUAL_CACHE",
  "alias": "OTLP Virtual Cache",
  "group": "OpenTelemetry",
  "color": "var(--sw-warn)",
  "documentLink": "https://skywalking.apache.org/docs/main/next/en/setup/backend/trace-analyzer/#layers",
  "aliases": {
    "services": "Caches"
  },
  "components": {
    "service": true,
    "instances": false,
    "endpoints": false,
    "endpointDependency": false,
    "topology": false,
    "traces": false,
    "logs": false
  },
  "layer-header": {
    "orderBy": "cpm",
    "columns": [
      {
        "metric": "cpm",
        "label": "Access RPM",
        "unit": "rpm",
        "mqe": "otlp_cache_access_cpm",
        "aggregation": "sum"
      },
      {
        "metric": "respTime",
        "label": "Latency",
        "unit": "ms",
        "mqe": "otlp_cache_access_resp_time",
        "aggregation": "avg"
      },
      {
        "metric": "err",
        "label": "Error Rate",
        "unit": "%",
        "mqe": "100 - otlp_cache_access_sla/100",
        "aggregation": "avg"
      }
    ]
  },
  "dashboards": {
    "service": [
      {
        "id": "traffic_line",
        "title": "Access Traffic",
        "tip": "Commands per minute, counted from the client spans of the OpenTelemetry services that call this cache.",
        "type": "line",
        "unit": "rpm",
        "expressions": [
          "otlp_cache_access_cpm"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "resp_time_line",
        "title": "Avg Response Time",
        "tip": "Mean latency of the callers' client spans, in ms.",
        "type": "line",
        "unit": "ms",
        "expressions": [
          "otlp_cache_access_resp_time"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "sla_line",
        "title": "Success Rate",
        "tip": "Percent of the callers' client spans that did not fail: a span fails on status ERROR or an HTTP status of 400 or above.",
        "type": "line",
        "unit": "%",
        "expressions": [
          "otlp_cache_access_sla/100"
        ],
        "span": 4,
        "rowSpan": 2
      }
    ]
  }
}
