{
  "alias": "OAP",
  "group": "自我观测",
  "slots": {
    "services": "OAP 服务",
    "instances": "OAP 节点"
  },
  "dashboards": {
    "instance": [
      {
        "id": "oap_node",
        "title": "OAP 节点",
        "tabs": [
          {
            "name": "接收器与 JVM",
            "widgets": [
              {
                "id": "cpu",
                "title": "CPU（%）"
              },
              {
                "id": "mem",
                "title": "JVM 内存（MB）"
              },
              {
                "id": "gc_count",
                "title": "GC 次数 / 分钟"
              },
              {
                "id": "gc_time",
                "title": "GC 时间（ms / 分钟）"
              },
              {
                "id": "buffer_pool",
                "title": "Buffer Pool（MB）"
              },
              {
                "id": "threads",
                "title": "线程数",
                "expressionLabels": [
                  "live",
                  "peak",
                  "daemon"
                ]
              },
              {
                "id": "thread_states",
                "title": "线程状态",
                "expressionLabels": [
                  "runnable",
                  "timed-waiting",
                  "blocked",
                  "waiting"
                ]
              },
              {
                "id": "classes",
                "title": "类数量",
                "expressionLabels": [
                  "loaded",
                  "unloaded total",
                  "loaded total"
                ]
              },
              {
                "id": "watermark",
                "title": "Watermark 熔断器",
                "tip": "每个监听器累计 break + recover 计数。",
                "expressionLabels": [
                  "break",
                  "recover"
                ]
              },
              {
                "id": "trace_analysis",
                "title": "Trace Span 分析数 / 分钟",
                "tip": "按协议统计每分钟分析的 Span：SkyWalking 探针的 grpc、http、kafka，zipkin-http、zipkin-kafka，otlp-grpc、otlp-http。错误统计整体处理失败的 Trace 数据：一个探针 Segment、一个 Zipkin 请求或 Kafka 消息、一个 OTLP 导出请求。",
                "expressionLabels": [
                  "total",
                  "errors"
                ]
              },
              {
                "id": "trace_latency",
                "title": "Trace 分析延迟（ms / 1,000 Span）",
                "tip": "分析 1,000 个 Span 所需时间的 p50 至 p99，按每个 Span 记录。探针 Segment 整体分析，其中的 Span 共用 Segment 的平均值。"
              },
              {
                "id": "mesh_analysis",
                "title": "Mesh 分析 / 分钟",
                "expressionLabels": [
                  "total",
                  "errors"
                ]
              },
              {
                "id": "mesh_latency",
                "title": "Mesh 分析延迟（ms）"
              },
              {
                "id": "otel_received",
                "title": "OTel 接收 / 分钟",
                "tip": "每分钟通过 OTLP 接收的指标、日志和 Span，以及因资源未指明服务而被拒绝的 Span。",
                "expressionLabels": [
                  "metrics",
                  "logs",
                  "spans",
                  "spans rejected"
                ]
              },
              {
                "id": "k8s_als",
                "title": "K8s ALS",
                "expressionLabels": [
                  "count",
                  "dropped",
                  "streams",
                  "err streams"
                ]
              },
              {
                "id": "spans_dropped",
                "title": "Trace Span 丢弃数 / 分钟",
                "tip": "已接收但未存储的 Span，按协议（zipkin-http、zipkin-kafka、otlp-grpc、otlp-http）和原因（sampled、rate_limited、store_failed、process_failed）区分。"
              }
            ]
          },
          {
            "name": "持久化与存储",
            "widgets": [
              {
                "id": "persistence_counts",
                "title": "持久化次数 / 分钟",
                "expressionLabels": [
                  "prepare",
                  "execute"
                ]
              },
              {
                "id": "persistence_cache",
                "title": "持久化缓存 / 分钟"
              },
              {
                "id": "persist_prepare_latency",
                "title": "持久化 Prepare 延迟（ms）"
              },
              {
                "id": "persist_execute_latency",
                "title": "持久化 Execute 延迟（ms）"
              },
              {
                "id": "banyandb_latency",
                "title": "BanyanDB 写延迟（ms）",
                "expressionLabels": [
                  "measure bulk",
                  "stream bulk",
                  "trace bulk",
                  "stream single",
                  "property"
                ]
              },
              {
                "id": "es_latency",
                "title": "Elasticsearch 写延迟（ms）",
                "expressionLabels": [
                  "single",
                  "bulk"
                ]
              }
            ]
          },
          {
            "name": "聚合与集群",
            "widgets": [
              {
                "id": "cluster_size",
                "title": "集群规模",
                "tip": "当前节点看到的集群中聚合节点（Mixed 或 Aggregator 角色）数：最新上报值及其变化趋势。除非当前节点以 Receiver 角色运行，否则包含自身；出现下降说明有节点退出了集群。"
              },
              {
                "id": "aggregation",
                "title": "聚合 / 分钟"
              },
              {
                "id": "aggr_queue",
                "title": "聚合队列使用率（%）",
                "expressionLabels": [
                  "L1",
                  "L2"
                ]
              },
              {
                "id": "remote_traffic",
                "title": "集群 Remote 流量 / 分钟",
                "tip": "当前节点发往其他节点（发送尝试）和自身的消息数，以及从其他节点收到的消息数（左轴）。右轴：发送错误（每次失败的发送或失败的流计一次，与其携带的消息数无关）、接收错误，以及收到的、本节点不存在对应 worker 的消息数——后者常说明各节点运行的 OAL / MAL 规则不一致。",
                "expressionLabels": [
                  "发往对端",
                  "本地发送",
                  "接收",
                  "发送错误",
                  "接收错误",
                  "目标缺失"
                ]
              },
              {
                "id": "remote_latency",
                "title": "集群 Remote 发送延迟 p99（ms）",
                "tip": "发往最慢的五个对端的批次从发出到完成的 p99 耗时（含对端处理）。某分钟内没有批次完成的对端显示为 0；从未有批次完成的对端不显示曲线。"
              },
              {
                "id": "remote_streams",
                "title": "集群 Remote 流",
                "tip": "发往其他节点的已打开 gRPC 流数，每个对端最多 10 个（左轴）；以及等待空闲流槽位的时间，单位为每分钟 ms（右轴）。单机节点没有对端，不显示数据。",
                "expressionLabels": [
                  "进行中",
                  "阻塞等待"
                ]
              },
              {
                "id": "remote_queue",
                "title": "集群 Remote 发送队列（%）",
                "tip": "发往每个其他节点的发送队列占用率，取最满的五个。单机节点没有对端，不显示数据。"
              }
            ]
          },
          {
            "name": "查询与告警",
            "widgets": [
              {
                "id": "graphql_latency",
                "title": "GraphQL 延迟（ms）"
              },
              {
                "id": "graphql_count",
                "title": "GraphQL 查询数",
                "expressionLabels": [
                  "queries",
                  "errors"
                ]
              },
              {
                "id": "alarm_delivery",
                "title": "告警投递 / 分钟",
                "tip": "各通道（HTTP 与 gRPC）告警钩子的投递次数，按结果区分：成功，或投递失败的原因。"
              },
              {
                "id": "alarm_delivery_status",
                "title": "告警投递响应 / 分钟",
                "tip": "各通道 HTTP 告警钩子收到的响应次数，按状态码类别区分。"
              },
              {
                "id": "alarm_delivery_latency",
                "title": "告警投递延迟（ms）",
                "tip": "各通道（HTTP 与 gRPC）告警钩子的投递延迟。"
              }
            ]
          }
        ]
      }
    ]
  }
}
