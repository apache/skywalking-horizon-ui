{
  "key": "OS_LINUX",
  "alias": "Linux",
  "group": "OS",
  "color": "var(--sw-fg-1)",
  "documentLink": "https://skywalking.apache.org/docs/main/next/en/setup/backend/backend-vm-monitoring/",
  "aliases": {
    "services": "Hosts",
    "instances": "Processes"
  },
  "components": {
    "service": true,
    "instances": true,
    "endpoints": false,
    "topology": false,
    "traces": false,
    "logs": false
  },
  "layer-header": {
    "orderBy": "cpu",
    "columns": [
      {
        "metric": "cpu",
        "label": "CPU total %",
        "unit": "%",
        "mqe": "meter_vm_cpu_total_percentage",
        "aggregation": "avg"
      },
      {
        "metric": "memUsed",
        "label": "Memory MB",
        "unit": "MB",
        "mqe": "meter_vm_memory_used/1024/1024",
        "aggregation": "avg"
      },
      {
        "metric": "load1",
        "label": "Load 1m",
        "mqe": "meter_vm_cpu_load1/100",
        "aggregation": "avg"
      },
      {
        "metric": "fs",
        "label": "FS %",
        "unit": "%",
        "mqe": "meter_vm_filesystem_percentage",
        "aggregation": "avg"
      }
    ]
  },
  "dashboards": {
    "service": [
      {
        "id": "cpu_total_now",
        "title": "CPU Across Cores",
        "tip": "Current non-idle CPU summed across logical processors. This preserves the traditional host metric scale, so four fully busy CPUs report 400%.",
        "type": "card",
        "unit": "%",
        "expressions": [
          "latest(meter_vm_cpu_total_percentage)"
        ],
        "format": "decimal",
        "span": 3,
        "rowSpan": 1
      },
      {
        "id": "cpu_norm_now",
        "title": "Normalized CPU",
        "tip": "Current CPU use normalized by logical CPU count to the conventional 0–100% host scale. Available from OpenTelemetry hostmetrics.",
        "type": "card",
        "unit": "%",
        "expressions": [
          "latest(meter_vm_cpu_norm_percentage)"
        ],
        "format": "decimal",
        "span": 3,
        "rowSpan": 1,
        "visibleWhen": {
          "kind": "mqe",
          "expression": "meter_vm_cpu_norm_percentage",
          "op": "exists"
        }
      },
      {
        "id": "cpu_cores_now",
        "title": "Logical CPUs",
        "tip": "Number of logical processors reported by OpenTelemetry hostmetrics.",
        "type": "card",
        "unit": "cores",
        "expressions": [
          "latest(meter_vm_cpu_cores_num)"
        ],
        "format": "int",
        "span": 3,
        "rowSpan": 1,
        "visibleWhen": {
          "kind": "mqe",
          "expression": "meter_vm_cpu_cores_num",
          "op": "exists"
        }
      },
      {
        "id": "swap_used_now",
        "title": "Swap Used",
        "tip": "Current percentage of configured swap space in use.",
        "type": "card",
        "unit": "%",
        "expressions": [
          "latest(meter_vm_memory_swap_percentage)"
        ],
        "format": "decimal",
        "span": 3,
        "rowSpan": 1
      },
      {
        "id": "cpu",
        "title": "CPU by State (sum across cores)",
        "tip": "Utilization in each CPU state summed across logical processors. Values may exceed 100%; use Normalized CPU for the conventional host percentage.",
        "type": "line",
        "unit": "%",
        "expressions": [
          "meter_vm_cpu_average_used"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "cpu_load",
        "title": "CPU Load",
        "type": "line",
        "expressions": [
          "meter_vm_cpu_load1/100",
          "meter_vm_cpu_load5/100",
          "meter_vm_cpu_load15/100"
        ],
        "expressionLabels": [
          "1m",
          "5m",
          "15m"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "cpu_norm_ts",
        "title": "Normalized CPU",
        "tip": "CPU use normalized by logical CPU count to the conventional 0–100% host scale. Available from OpenTelemetry hostmetrics.",
        "type": "line",
        "unit": "%",
        "expressions": [
          "meter_vm_cpu_norm_percentage"
        ],
        "format": "decimal",
        "span": 4,
        "rowSpan": 2,
        "visibleWhen": {
          "kind": "mqe",
          "expression": "meter_vm_cpu_norm_percentage",
          "op": "exists"
        }
      },
      {
        "id": "filefd",
        "title": "File FD Allocated",
        "type": "line",
        "expressions": [
          "meter_vm_filefd_allocated"
        ],
        "span": 4,
        "rowSpan": 2,
        "visibleWhen": {
          "kind": "mqe",
          "expression": "meter_vm_filefd_allocated",
          "op": "exists"
        }
      },
      {
        "id": "memory",
        "title": "Memory RAM (MB)",
        "type": "line",
        "unit": "MB",
        "expressions": [
          "meter_vm_memory_used/1024/1024",
          "meter_vm_memory_total/1024/1024",
          "meter_vm_memory_available/1024/1024",
          "meter_vm_memory_buff_cache/1024/1024"
        ],
        "expressionLabels": [
          "used",
          "total",
          "available",
          "buff/cache"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "swap",
        "title": "Memory Swap (MB)",
        "type": "line",
        "unit": "MB",
        "expressions": [
          "meter_vm_memory_swap_free/1024/1024",
          "meter_vm_memory_swap_total/1024/1024"
        ],
        "expressionLabels": [
          "free",
          "total"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "network_bandwidth",
        "title": "Network Bandwidth (KB/s)",
        "type": "line",
        "unit": "KB/s",
        "expressions": [
          "meter_vm_network_receive/1024",
          "meter_vm_network_transmit/1024"
        ],
        "expressionLabels": [
          "receive",
          "transmit"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "disk",
        "title": "Disk R/W (KB/s)",
        "type": "line",
        "unit": "KB/s",
        "expressions": [
          "meter_vm_disk_read/1024",
          "meter_vm_disk_written/1024"
        ],
        "expressionLabels": [
          "read",
          "written"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "fs",
        "title": "Filesystem Usage (%)",
        "type": "line",
        "unit": "%",
        "expressions": [
          "meter_vm_filesystem_percentage"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "network_status",
        "title": "TCP Connections",
        "tip": "Established and time-wait TCP connections. Available from both node-exporter and OpenTelemetry hostmetrics.",
        "type": "line",
        "expressions": [
          "meter_vm_tcp_curr_estab",
          "meter_vm_tcp_tw"
        ],
        "expressionLabels": [
          "tcp estab",
          "tcp time-wait"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "socket_counters",
        "title": "Linux Socket Counters",
        "tip": "Node-exporter socket counters. This panel is hidden when only OpenTelemetry hostmetrics is reporting.",
        "type": "line",
        "expressions": [
          "meter_vm_tcp_alloc",
          "meter_vm_sockets_used",
          "meter_vm_udp_inuse"
        ],
        "expressionLabels": [
          "tcp alloc",
          "sockets used",
          "udp in-use"
        ],
        "span": 6,
        "rowSpan": 2,
        "visibleWhen": {
          "kind": "mqe",
          "expression": "meter_vm_tcp_alloc",
          "op": "exists"
        }
      },
      {
        "id": "process_top_cpu",
        "title": "Top Processes by CPU",
        "tip": "Process groups with the highest CPU consumption in the selected host.",
        "type": "top",
        "expressions": [
          "top_n(mp_process_linux_cpu_total_percent,10,des)",
          "top_n(mp_process_linux_cpu_user_percent,10,des)",
          "top_n(mp_process_linux_cpu_system_percent,10,des)"
        ],
        "expressionLabels": [
          "total",
          "user",
          "system"
        ],
        "expressionUnits": [
          "%",
          "%",
          "%"
        ],
        "unit": "%",
        "span": 4,
        "rowSpan": 3
      },
      {
        "id": "process_top_memory",
        "title": "Top Processes by Memory",
        "tip": "Process groups ranked by resident physical memory or percentage of host RAM.",
        "type": "top",
        "expressions": [
          "top_n(mp_process_linux_memory_resident_bytes,10,des)/1024/1024",
          "top_n(mp_process_linux_memory_resident_percent,10,des)/100"
        ],
        "expressionLabels": [
          "resident",
          "resident %"
        ],
        "expressionUnits": [
          "MB",
          "%"
        ],
        "unit": "MB",
        "span": 4,
        "rowSpan": 3
      },
      {
        "id": "process_top_resources",
        "title": "Top Processes by Resources",
        "tip": "Process groups ranked by thread count, open FDs or number of grouped processes.",
        "type": "top",
        "expressions": [
          "top_n(mp_process_linux_num_threads,10,des)",
          "top_n(mp_process_linux_open_handles,10,des)",
          "top_n(mp_process_linux_num_procs,10,des)"
        ],
        "expressionLabels": [
          "threads",
          "open FDs",
          "processes"
        ],
        "expressionUnits": [
          "threads",
          "FDs",
          "processes"
        ],
        "span": 4,
        "rowSpan": 3
      }
    ],
    "instance": [
      {
        "id": "process_cpu_card",
        "title": "CPU Used",
        "tip": "Current CPU utilization of the selected normalized process group.",
        "type": "card",
        "unit": "%",
        "expressions": [
          "latest(mp_process_linux_cpu_total_percent)"
        ],
        "format": "decimal",
        "span": 3,
        "rowSpan": 1
      },
      {
        "id": "process_memory_card",
        "title": "Resident Memory",
        "tip": "Current physical memory used by the selected process group.",
        "type": "card",
        "unit": "MB",
        "expressions": [
          "latest(mp_process_linux_memory_resident_bytes)/1024/1024"
        ],
        "format": "decimal",
        "span": 3,
        "rowSpan": 1
      },
      {
        "id": "process_memory_percent_card",
        "title": "Host Memory Used",
        "tip": "Percentage of host physical memory used by the selected process group.",
        "type": "card",
        "unit": "%",
        "expressions": [
          "latest(mp_process_linux_memory_resident_percent)/100"
        ],
        "format": "decimal",
        "span": 3,
        "rowSpan": 1
      },
      {
        "id": "process_count_card",
        "title": "Processes",
        "tip": "Number of OS processes pre-aggregated into this normalized process group.",
        "type": "card",
        "unit": "processes",
        "expressions": [
          "latest(mp_process_linux_num_procs)"
        ],
        "format": "int",
        "span": 3,
        "rowSpan": 1
      },
      {
        "id": "process_threads_card",
        "title": "Threads",
        "tip": "Total threads in the selected process group.",
        "type": "card",
        "unit": "threads",
        "expressions": [
          "latest(mp_process_linux_num_threads)"
        ],
        "format": "int",
        "span": 4,
        "rowSpan": 1
      },
      {
        "id": "process_handles_card",
        "title": "Open File Descriptors",
        "tip": "Total open file descriptors in the selected process group.",
        "type": "card",
        "unit": "FDs",
        "expressions": [
          "latest(mp_process_linux_open_handles)"
        ],
        "format": "int",
        "span": 4,
        "rowSpan": 1
      },
      {
        "id": "process_uptime_card",
        "title": "Oldest Process Uptime",
        "tip": "Uptime of the oldest OS process in the selected group.",
        "type": "card",
        "unit": "hours",
        "expressions": [
          "latest(mp_process_linux_oldest_process_uptime_seconds)/3600"
        ],
        "format": "decimal",
        "span": 4,
        "rowSpan": 1
      },
      {
        "id": "process_cpu_history",
        "title": "CPU Usage",
        "type": "line",
        "unit": "%",
        "expressions": [
          "mp_process_linux_cpu_total_percent",
          "mp_process_linux_cpu_user_percent",
          "mp_process_linux_cpu_system_percent"
        ],
        "expressionLabels": [
          "total",
          "user",
          "system"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "process_memory_history",
        "title": "Resident Memory",
        "type": "line",
        "unit": "MB",
        "expressions": [
          "mp_process_linux_memory_resident_bytes/1024/1024"
        ],
        "expressionLabels": [
          "resident"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "process_memory_percent_history",
        "title": "Host Memory Used by Process",
        "type": "line",
        "unit": "%",
        "expressions": [
          "mp_process_linux_memory_resident_percent/100"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "process_counts_history",
        "title": "Processes and Threads",
        "type": "line",
        "expressions": [
          "mp_process_linux_num_procs",
          "mp_process_linux_num_threads"
        ],
        "expressionLabels": [
          "processes",
          "threads"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "process_handles_history",
        "title": "Open File Descriptors",
        "type": "line",
        "unit": "FDs",
        "expressions": [
          "mp_process_linux_open_handles"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "process_uptime_history",
        "title": "Oldest Process Uptime",
        "tip": "A drop can indicate that the oldest process restarted or disappeared.",
        "type": "line",
        "unit": "hours",
        "expressions": [
          "mp_process_linux_oldest_process_uptime_seconds/3600"
        ],
        "span": 12,
        "rowSpan": 2
      }
    ]
  }
}
