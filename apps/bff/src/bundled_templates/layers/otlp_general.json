{
  "key": "OTLP_GENERAL",
  "alias": "OTLP Service",
  "group": "OpenTelemetry",
  "color": "var(--sw-info)",
  "documentLink": "https://skywalking.apache.org/docs/main/next/en/setup/backend/trace-analyzer/",
  "aliases": {
    "services": "Services",
    "instances": "Instances",
    "endpoints": "Endpoints"
  },
  "components": {
    "service": true,
    "instances": true,
    "endpoints": true,
    "endpointDependency": false,
    "topology": true,
    "traces": true,
    "logs": false,
    "traceProfiling": false,
    "ebpfProfiling": false,
    "asyncProfiling": false,
    "pprofProfiling": false
  },
  "traces": {
    "sources": ["traceql-otlp"],
    "stores": {
      "traceql-otlp": {
        "serviceLayer": "OTLP_GENERAL"
      }
    }
  },
  "layer-header": {
    "orderBy": "cpm",
    "columns": [
      {
        "metric": "cpm",
        "label": "RPM",
        "unit": "rpm",
        "mqe": "otlp_service_cpm",
        "aggregation": "sum"
      },
      {
        "metric": "apdex",
        "label": "Apdex",
        "mqe": "otlp_service_apdex/10000",
        "aggregation": "avg"
      },
      {
        "metric": "respTime",
        "label": "Latency",
        "unit": "ms",
        "mqe": "otlp_service_resp_time",
        "aggregation": "avg"
      },
      {
        "metric": "err",
        "label": "Error Rate",
        "unit": "%",
        "mqe": "100 - otlp_service_sla/100",
        "aggregation": "avg"
      }
    ]
  },
  "topology": {
    "nodeMetrics": [
      {
        "id": "cpm",
        "label": "RPM",
        "mqe": "otlp_service_cpm",
        "unit": "rpm",
        "role": "center",
        "aggregation": "avg"
      },
      {
        "id": "sla",
        "label": "SLA",
        "mqe": "otlp_service_sla/100",
        "unit": "%",
        "role": "ring",
        "aggregation": "avg",
        "thresholds": {
          "invertHealth": true,
          "invertBase": 100,
          "ok": 0.1,
          "warn": 1,
          "danger": 5
        }
      },
      {
        "id": "respTime",
        "label": "Latency",
        "mqe": "otlp_service_resp_time",
        "unit": "ms",
        "role": "secondary",
        "aggregation": "avg"
      }
    ],
    "linkServerMetrics": [
      {
        "id": "cpm",
        "label": "RPM",
        "mqe": "otlp_service_relation_server_cpm",
        "unit": "rpm",
        "role": "lineServer",
        "aggregation": "avg"
      }
    ],
    "linkClientMetrics": [
      {
        "id": "cpm",
        "label": "RPM",
        "mqe": "otlp_service_relation_client_cpm",
        "unit": "rpm",
        "role": "lineClient",
        "aggregation": "avg"
      },
      {
        "id": "respTime",
        "label": "Avg response time",
        "mqe": "otlp_service_relation_client_resp_time",
        "unit": "ms",
        "aggregation": "avg"
      },
      {
        "id": "sla",
        "label": "SLA",
        "mqe": "otlp_service_relation_client_call_sla/100",
        "unit": "%",
        "aggregation": "avg"
      }
    ]
  },
  "dashboards": {
    "service": [
      {
        "id": "top_endpoints",
        "title": "Top 20 Endpoints",
        "tip": "Top endpoints of the selected service, named `<method> <route>` for HTTP spans and by the span name otherwise. Switch tabs to re-rank by traffic, response time, or worst success rate.",
        "type": "top",
        "expressions": [
          "top_n(otlp_endpoint_cpm,20,des)",
          "top_n(otlp_endpoint_resp_time,20,des)",
          "top_n(otlp_endpoint_sla,20,asc)/100"
        ],
        "expressionLabels": [
          "Traffic",
          "Slow",
          "Successful Rate"
        ],
        "expressionUnits": [
          "rpm",
          "ms",
          "%"
        ],
        "span": 3,
        "rowSpan": 4
      },
      {
        "id": "traffic_line",
        "title": "Traffic",
        "tip": "Server and consumer spans per minute, counted by the TAL rule ahead of the receiver's own sampling.",
        "type": "line",
        "unit": "rpm",
        "expressions": [
          "otlp_service_cpm"
        ],
        "span": 3,
        "rowSpan": 2
      },
      {
        "id": "err_line",
        "title": "Error Rate",
        "tip": "Percent of server and consumer spans that failed: status ERROR, or an HTTP status of 400 or above.",
        "type": "line",
        "unit": "%",
        "expressions": [
          "100 - otlp_service_sla/100"
        ],
        "span": 3,
        "rowSpan": 2
      },
      {
        "id": "apdex_line",
        "title": "Apdex",
        "tip": "Apdex from the span latencies, with the threshold `service-apdex-threshold.yml` gives this service.",
        "type": "line",
        "expressions": [
          "otlp_service_apdex/10000"
        ],
        "span": 3,
        "rowSpan": 2
      },
      {
        "id": "percentile_line",
        "title": "Response Time Percentile",
        "tip": "p50 / p75 / p90 / p95 / p99 of the server and consumer span latency, from the rule's buckets.",
        "type": "line",
        "unit": "ms",
        "expressions": [
          "relabels(otlp_service_percentile{p='50,75,90,95,99'},p='50,75,90,95,99',percentile='50,75,90,95,99')"
        ],
        "span": 6,
        "rowSpan": 2
      },
      {
        "id": "resp_time_line",
        "title": "Avg Response Time",
        "type": "line",
        "unit": "ms",
        "expressions": [
          "otlp_service_resp_time"
        ],
        "span": 3,
        "rowSpan": 2
      },
      {
        "id": "top_instances_load",
        "title": "Top 10 instances by load",
        "tip": "Instances exist only when the resource carries `service.instance.id`.",
        "type": "top",
        "unit": "rpm",
        "expressions": [
          "top_n(otlp_service_instance_cpm,10,des)"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "top_instances_slow",
        "title": "Top 10 slowest instances",
        "type": "top",
        "unit": "ms",
        "expressions": [
          "top_n(otlp_service_instance_resp_time,10,des)"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "top_instances_sla",
        "title": "Top 10 instances by success rate",
        "type": "top",
        "unit": "%",
        "expressions": [
          "top_n(otlp_service_instance_sla,10,asc)/100"
        ],
        "span": 4,
        "rowSpan": 2
      }
    ],
    "instance": [
      {
        "id": "instance_cpm_line",
        "title": "Service Instance Load",
        "tip": "Server and consumer spans per minute reported by the selected instance.",
        "type": "line",
        "unit": "rpm",
        "expressions": [
          "otlp_service_instance_cpm"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "instance_resp_line",
        "title": "Service Instance Latency",
        "type": "line",
        "unit": "ms",
        "expressions": [
          "otlp_service_instance_resp_time"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "instance_sla_line",
        "title": "Service Instance Success Rate",
        "type": "line",
        "unit": "%",
        "expressions": [
          "otlp_service_instance_sla/100"
        ],
        "span": 4,
        "rowSpan": 2
      }
    ],
    "endpoint": [
      {
        "id": "endpoint_cpm_line",
        "title": "Traffic",
        "type": "line",
        "unit": "rpm",
        "expressions": [
          "otlp_endpoint_cpm"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "endpoint_resp_line",
        "title": "Response Time",
        "type": "line",
        "unit": "ms",
        "expressions": [
          "otlp_endpoint_resp_time"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "endpoint_sla_line",
        "title": "Success Rate",
        "type": "line",
        "unit": "%",
        "expressions": [
          "otlp_endpoint_sla/100"
        ],
        "span": 4,
        "rowSpan": 2
      },
      {
        "id": "endpoint_percentile_line",
        "title": "Response Time Percentile",
        "tip": "p50 / p75 / p90 / p95 / p99 of the endpoint's server and consumer span latency.",
        "type": "line",
        "unit": "ms",
        "expressions": [
          "relabels(otlp_endpoint_percentile{p='50,75,90,95,99'},p='50,75,90,95,99',percentile='50,75,90,95,99')"
        ],
        "span": 12,
        "rowSpan": 2
      }
    ]
  }
}
