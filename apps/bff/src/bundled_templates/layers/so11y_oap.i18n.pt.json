                  "em andamento",
                  "espera de bloqueio"
                ]
              },
              {
                "id": "remote_queue",
                "title": "Fila de envio remoto do cluster (%)",
                "tip": "Nível de ocupação da fila de envio para cada outro nó, para as cinco mais cheias."
