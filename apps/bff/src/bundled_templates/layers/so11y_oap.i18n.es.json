                  "enviados a pares",
                  "enviados localmente",
                  "recibidos",
                  "errores de envío",
                  "errores de recepción",
                  "destino ausente"
                ]
              },
              {
                "id": "remote_latency",
                "title": "Latencia remota del clúster (ms)",
                "tip": "Tiempo p99 hasta que se completa un lote enviado a un par, incluido su procesamiento en el par, para los cinco pares más lentos; y tiempo p99 que este nodo tarda en procesar un mensaje recibido. Un par marca 0 en un minuto en el que no se completó ningún lote hacia él.",
                "expressionLabels": [
                  "envío p99",
                  "procesamiento p99"
                ]
              },
              {
                "id": "remote_streams",
                "title": "Streams remotos del clúster",
                "tip": "Streams gRPC abiertos hacia otros nodos, como máximo 10 por par (eje izquierdo), y tiempo de espera de un hueco libre de stream, en ms por minuto (eje derecho).",
                "expressionLabels": [
                  "en curso",
                  "espera de bloqueo"
                ]
              },
              {
                "id": "remote_queue",
                "title": "Cola de envío remoto del clúster (%)",
                "tip": "Nivel de ocupación de la cola de envío hacia cada otro nodo, para las cinco más llenas."
              }
            ]
