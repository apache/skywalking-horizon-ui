      },
      {
        "id": "envoy_up_rq_incr",
        "title": "Envoy 上游请求增量",
        "tip": "每分钟新增的上游请求数。"
      },
      {
        "id": "envoy_up_rq_pending_active",
        "title": "Envoy 上游 Pending 活跃",
        "tip": "Pending 上游请求 — 指示连接池反压。"
      },
      {
        "id": "envoy_up_cx_active",
        "title": "Envoy 上游活跃连接"
      },
      {
        "id": "envoy_up_cx_incr",
        "title": "Envoy 上游连接增量"
      },
      {
        "id": "envoy_membership_healthy",
        "title": "Envoy 集群健康成员数",
        "tip": "每个集群的健康上游成员数 — 显著下降意味着上游变动。"
      },
      {
        "id": "envoy_connections",
        "title": "Envoy 总连接数",
        "expressionLabels": [
          "total",
          "parent"
        ]
      },
      {
        "id": "envoy_heap_memory",
        "title": "Envoy Heap 内存",
        "tip": "Envoy 内存使用。Heap vs 物理，已分配 vs 最大，单位 MB。",
        "expressionLabels": [
          "heap used",
          "heap max",
          "allocated",
          "allocated max",
          "physical",
          "physical max"
        ]
      },
      {
        "id": "envoy_worker_threads",
        "title": "Envoy Worker 线程",
        "expressionLabels": [
          "live",
          "max"
        ]
      },
      {
        "id": "envoy_bug_failures",
        "title": "Envoy Bug 失败",
        "tip": "Envoy 自身的 assertion / bug 计数器。健康集群中应为零。"
      }
    ],
