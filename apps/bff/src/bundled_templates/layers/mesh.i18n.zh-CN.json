{
  "alias": "Istio 管理的服务",
  "group": "Istio",
  "slots": {
    "services": "服务",
    "instances": "Sidecar",
    "endpoints": "端点"
  },
  "layer-header": {
    "columns": [
      {
        "label": "流量"
      },
      {
        "label": "Apdex"
      },
      {
        "label": "延迟"
      },
      {
        "label": "错误率"
      }
    ]
  },
  "dashboards": {
    "service": [
      {
        "id": "top_apis",
        "title": "前 20 API",
        "tip": "所选服务下的 Top 端点列表。切换标签可按流量、响应时间或最差成功率重新排序。",
        "expressionLabels": [
          "流量",
          "慢请求",
          "成功率"
        ]
      },
      {
        "id": "traffic_line",
        "title": "流量",
        "tip": "Envoy Sidecar 观测到的 Mesh 全局每分钟请求数。"
      },
      {
        "id": "err_line",
        "title": "错误率"
      },
      {
        "id": "apdex_line",
        "title": "Apdex",
        "tip": "用户满意度评分，取值范围 0 – 1。"
      },
      {
        "id": "resp_time_line",
        "title": "平均响应时间"
      },
      {
        "id": "percentile_line",
        "title": "响应时间分位",
        "tip": "p50 / p75 / p90 / p95 / p99 延迟 — 即响应时间分布的长尾。"
      },
      {
        "id": "throughput_line",
        "title": "服务吞吐",
        "tip": "通过 Sidecar 的每分钟字节数 — 发送 + 接收。",
        "expressionLabels": [
          "received",
          "sent"
        ]
      },
      {
        "id": "sidecar_internal_latency",
        "title": "Sidecar 内部延迟",
        "tip": "Envoy 内部请求 + 响应延迟，单位纳秒。怀疑 Sidecar 开销时有用。",
        "expressionLabels": [
          "request",
          "response"
        ]
      },
      {
        "id": "top_instances",
        "title": "前 10 Sidecar",
        "tip": "在所选服务的 Sidecar 实例之间排序。",
        "expressionLabels": [
          "流量",
          "慢请求",
          "成功率"
        ]
      }
    ],
    "instance": [
      {
        "id": "instance_cpm_line",
        "title": "Sidecar 负载",
        "tip": "针对所选 Sidecar 实例每分钟的调用次数。"
      },
      {
        "id": "instance_resp_line",
        "title": "Sidecar 延迟"
      },
