                  "ピアへ送信",
                  "ローカル送信",
                  "受信",
                  "送信エラー",
                  "受信エラー",
                  "ターゲット欠落"
                ]
              },
              {
                "id": "remote_latency",
                "title": "クラスタ Remote 送信レイテンシ p99 (ms)",
