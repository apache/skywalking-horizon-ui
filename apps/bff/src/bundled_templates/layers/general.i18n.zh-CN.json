      {
        "id": "jvm_memory",
        "title": "JVM 内存",
        "tip": "Heap / 非 Heap 的已用 + 最大值，单位 MB。",
        "expressionLabels": [
          "heap",
          "heap max",
          "non-heap",
          "non-heap max"
        ]
      },
      {
        "id": "jvm_memory_detail",
        "title": "JVM 内存明细",
        "tip": "各内存池已用大小，单位 MB。覆盖 code cache、young / old / survivor / permgen / metaspace，以及新版 JVM 引入的 JIT codeheap 子池（Z heap、compressed class space、分段 codeheap）。JVM 未暴露的池保持为 0。",
        "expressionLabels": [
          "code cache",
          "newgen",
          "oldgen",
          "survivor",
          "permgen",
          "metaspace",
          "zheap",
          "compressed class space",
          "codeheap (non-nmethods)",
          "codeheap (profiled nmethods)",
          "codeheap (non-profiled nmethods)"
        ]
      },
