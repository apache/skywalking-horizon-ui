        "expressionLabels": [
          "数量",
          "延迟"
        ]
      },
      {
        "id": "top_instance_load",
        "title": "按负载排名的前 10 实例",
        "tip": "按所选服务下各实例的流量排序。"
      },
      {
        "id": "top_instance_slow",
        "title": "前 10 最慢实例",
        "tip": "按所选服务下各实例的平均响应时间排序。"
      },
      {
        "id": "top_instance_sla",
        "title": "按成功率排名的前 10 实例",
        "tip": "top_n(service_instance_sla,10,asc)/100 — 最差优先。"
      },
      {
        "id": "slow_statements",
        "title": "慢数据库语句",
        "tip": "针对此服务采集到的最慢的前 20 条数据库语句。来源为 top_n_service_database_statement。当 OAP 在该窗口内未采集到任何语句时显示 `no data`。"
      }
    ],
