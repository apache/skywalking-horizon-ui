      {
        "id": "top_apis",
        "title": "前 20 API",
        "tip": "所选服务下的 Top 端点列表。切换标签可按流量、响应时间或最差成功率重新排序。",
        "expressionLabels": [
          "流量",
          "慢请求",
          "成功率"
        ]
      },
      {
        "id": "traffic_line",
        "title": "流量"
      },
      {
