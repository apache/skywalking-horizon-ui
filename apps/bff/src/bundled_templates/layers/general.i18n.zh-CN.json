        "id": "nodejs_process_cpu",
        "title": "进程 CPU",
        "tip": "Node.js agent：进程 CPU（用户态 + 内核态），按采集间隔统计（%）。"
      },
      {
        "id": "nodejs_heap_used",
        "title": "V8 堆已用",
        "tip": "Node.js agent：V8 堆已用内存（process.memoryUsage().heapUsed），单位 MB。"
      },
      {
        "id": "nodejs_heap_total",
        "title": "V8 堆总量",
        "tip": "Node.js agent：V8 堆已分配总量（process.memoryUsage().heapTotal），单位 MB。"
      },
      {
        "id": "nodejs_heap_limit",
        "title": "V8 堆上限",
        "tip": "Node.js agent：V8 最大堆大小（v8.getHeapStatistics().heap_size_limit），单位 MB。"
      },
      {
        "id": "nodejs_rss",
        "title": "进程 RSS",
        "tip": "Node.js agent：常驻内存集（process.memoryUsage().rss），单位 MB。"
      },
      {
        "id": "nodejs_external_memory",
        "title": "外部内存",
        "tip": "Node.js agent：绑定到 V8 的 C++ 对象（process.memoryUsage().external），单位 MB。"
      },
      {
        "id": "nodejs_array_buffers",
        "title": "数组缓冲区",
        "tip": "Node.js agent：ArrayBuffer / SharedArrayBuffer 内存（process.memoryUsage().arrayBuffers），单位 MB。"
      },
      {
        "id": "nodejs_uptime",
        "title": "进程运行时间",
        "tip": "Node.js agent：进程启动至今的天数（process.uptime()）。"
      },
      {
        "id": "nodejs_peak_malloced_memory",
        "title": "峰值 malloc 内存",
