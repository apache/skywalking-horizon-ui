            "name": "Aggregation und Cluster",
            "widgets": [
              {
                "id": "cluster_size",
                "title": "Clustergröße",
                "tip": "Aggregationsknoten (Rolle Mixed oder Aggregator), die dieser Knoten im Cluster sieht: der zuletzt gemeldete Wert und der Verlauf. Dieser Knoten zählt mit, sofern er nicht mit der Rolle Receiver läuft; ein Einbruch bedeutet, dass ein Knoten den Cluster verlassen hat."
              },
              {
                "id": "aggregation",
                "title": "Aggregation / min"
              },
              {
                "id": "aggr_queue",
                "title": "Aggregations-Queue-Nutzung (%)",
                "expressionLabels": [
                  "L1",
                  "L2"
                ]
              },
              {
                "id": "remote_traffic",
                "title": "Cluster-Remote-Traffic / min",
                "tip": "Nachrichten, die dieser Knoten an andere Knoten (Versuche) und an sich selbst sendet und von anderen Knoten empfängt (linke Achse). Rechte Achse: Sendefehler – einer pro fehlgeschlagenem Senden oder Stream, egal wie viele Nachrichten er enthielt –, Empfangsfehler sowie empfangene Nachrichten für einen Worker, den dieser Knoten nicht hat, oft ein Zeichen für unterschiedliche OAL- / MAL-Regeln auf den Knoten.",
                "expressionLabels": [
                  "an Peers gesendet",
                  "lokal gesendet",
                  "empfangen",
                  "Sendefehler",
                  "Empfangsfehler",
                  "Ziel fehlt"
                ]
              },
              {
                "id": "remote_latency",
                "title": "Cluster-Remote-Sendelatenz p99 (ms)",
                "tip": "p99-Dauer, bis ein an einen der fünf langsamsten Peers gesendeter Batch abgeschlossen ist, einschließlich der Verarbeitung beim Peer. Ein Peer zeigt 0 in einer Minute, in der kein Batch an ihn abgeschlossen wurde; ein Peer, an den noch nie ein Batch abgeschlossen wurde, hat keine Linie."
              },
              {
                "id": "remote_streams",
                "title": "Cluster-Remote-Streams",
                "tip": "Offene gRPC-Streams zu anderen Knoten, höchstens 10 pro Peer (linke Achse), und Wartezeit auf einen freien Stream-Slot in ms pro Minute (rechte Achse). Ein Einzelknoten hat keine Peers und zeigt keine Daten.",
                "expressionLabels": [
                  "aktiv",
                  "Blockierwartezeit"
                ]
              },
              {
                "id": "remote_queue",
                "title": "Cluster-Remote-Sendewarteschlange (%)",
                "tip": "Füllstand der Sendewarteschlange zu jedem anderen Knoten, für die fünf vollsten. Ein Einzelknoten hat keine Peers und zeigt keine Daten."
              }
            ]
