{
  "name": "@skywalking-horizon-ui/conversation-view",
  "version": "1.1.0-dev",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Renders one asz.view document — an AI agent conversation as the SkyWalking AI Sessionizer assembles it — without a framework, on Horizon's design tokens.",
  "main": "./dist/conversation-view.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/conversation-view.js"
    },
    "./style.css": "./dist/conversation-view.css",
    "./host-shell/*": "./dist/host-shell/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-host-shell.mjs",
    "clean": "rm -rf dist",
    "prepare": "vite build && tsc -p tsconfig.build.json && node scripts/build-host-shell.mjs",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --environment jsdom --pool=threads",
    "test:unit:watch": "vitest --environment jsdom --pool=threads"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@skywalking-horizon-ui/design-tokens": "workspace:*",
    "@types/node": "^22.20.1",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
