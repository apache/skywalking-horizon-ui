{
  "name": "@skywalking-horizon-ui/api-client",
  "version": "1.1.0-dev",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --root src/ --pool=threads",
    "test:unit:watch": "vitest --root src/ --pool=threads"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^4.1.10"
  }
}
